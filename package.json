{
  "name": "nova-kits",
  "private": true,
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:beta": "pnpm build && changeset publish --tag beta",
    "release:rc": "pnpm build && changeset publish --tag rc",
    "prerelease:beta": "changeset pre enter beta && changeset version",
    "prerelease:rc": "changeset pre enter rc && changeset version",
    "prerelease:exit": "changeset pre exit",
    "prepare": "husky",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nova-kits/docs-plugin": "workspace:*",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "changesets": "^1.0.2",
    "element-plus": "^2.14.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^7.2.4",
    "vitepress": "^1.6.4",
    "vue": "^3.5.24",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.4"
  },
  "dependencies": {
    "vue-router": "^4.6.4"
  }
}
